        { "id": "m-thankyou", "page": "m-thankyou.html", "width": 430, "name": "Mobile / Confirmation" }
      ]
    },
    {
      "label": "Mobile · main flow (EN)",
      "frames": [
        { "id": "m-home-en", "page": "m-home-en.html", "width": 430, "name": "Mobile EN / Home" },
        { "id": "m-listing-en", "page": "m-listing-en.html", "width": 430, "name": "Mobile EN / Listing" },
        { "id": "m-hotel-en", "page": "m-hotel-en.html", "width": 430, "name": "Mobile EN / Hotel" },
        { "id": "m-checkout-en", "page": "m-checkout-en.html", "width": 430, "name": "Mobile EN / Checkout" },
        { "id": "m-thankyou-en", "page": "m-thankyou-en.html", "width": 430, "name": "Mobile EN / Confirmation" }
      ]
    },
    {
      "label": "Mobile · states",
      "frames": [
        { "id": "m-listing-denb", "page": "m-listing.html?density=b", "width": 430, "name": "Mobile / Listing — compact cards" },
        { "id": "m-listing-denc", "page": "m-listing.html?density=c", "width": 430, "name": "Mobile / Listing — summary cards" },
        { "id": "m-listing-member", "page": "m-listing.html?auth=in", "width": 430, "name": "Mobile / Listing — signed in" },
