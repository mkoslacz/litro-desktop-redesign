        { "id": "m-listing-zero", "page": "m-listing.html?inv=zero", "width": 430, "name": "Mobile / Listing — nothing available" },
        { "id": "m-hotel-room", "page": "m-hotel.html?room=2", "width": 430, "name": "Mobile / Hotel — room picked (booking bar up)" }
      ]
    }
  ]
