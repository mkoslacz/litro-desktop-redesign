// Firestore rules for the prototype stakeholder comment layer.
//
// Access model chosen for this prototype: a named allowlist only, no hosted-domain
// rule. A reviewer is admitted by one empty document at allowed/{their email} and by
// nothing else, so LITRO, Szallas and external reviewers are all added the same way
// and revoking access is deleting one document. The upstream template also offered a
// domain regex; it is deliberately absent here — the reviewers do not share one
// domain, and the owner's own address is a free-mail one, which a domain rule would
// have opened to the entire provider.
//
// An empty allowlist denies everybody. There is deliberately no open mode.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInWithEmail() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function explicitlyAllowed() {
      return exists(/databases/$(database)/documents/allowed/$(request.auth.token.email));
    }

    function reviewer() {
      return signedInWithEmail() && explicitlyAllowed();
    }

    function owner() {
      return signedInWithEmail()
        && exists(/databases/$(database)/documents/allowed/$(request.auth.token.email))
        && get(/databases/$(database)/documents/allowed/$(request.auth.token.email)).data.user == 'owner';
    }

    function boundedString(value, minimum, maximum) {
      return value is string
        && value.size() >= minimum
        && value.size() <= maximum
        && (minimum == 0 || value.matches('.*\\S.*'));
    }

    // Rules-enforceable anchor core. Dynamic map values cannot be universally
    // type-checked in Rules; browser and Admin validators additionally require
    // every state key and value to be a bounded string.
    function validAnchor(anchor) {
      return anchor is map
        && anchor.keys().hasOnly([
          'page', 'viewport', 'lang', 'state', 'selector', 'selectorKind', 'rx', 'ry', 'label', 'text'
        ])
        && anchor.keys().hasAll([
          'page', 'viewport', 'lang', 'state', 'selector', 'selectorKind', 'rx', 'ry', 'label', 'text'
        ])
        && boundedString(anchor.page, 1, 512)
        && anchor.viewport in ['desktop', 'mobile']
        && boundedString(anchor.lang, 1, 35)
        && anchor.state is map
        && anchor.state.size() <= 32
        && boundedString(anchor.selector, 1, 1024)
        && anchor.selectorKind in ['data', 'id', 'path']
        && anchor.rx is number && anchor.rx >= 0 && anchor.rx <= 1
        && anchor.ry is number && anchor.ry >= 0 && anchor.ry <= 1
        && boundedString(anchor.label, 1, 240)
        && boundedString(anchor.text, 0, 4000);
    }

    function parentAfter(prototypeId, threadId) {
      return getAfter(/databases/$(database)/documents/prototypes/$(prototypeId)/threads/$(threadId));
    }

    match /allowed/{email} {
      // A signed-in reviewer may inspect only their exact allowlist record.
      allow get: if signedInWithEmail() && email == request.auth.token.email;
      allow list, create, update, delete: if false;
    }

    match /prototypes/{prototypeId}/threads/{threadId} {
      allow read: if reviewer();
      allow create: if reviewer()
        && request.resource.data.createdBy.uid == request.auth.uid
        && request.resource.data.createdBy.email == request.auth.token.email
        && request.resource.data.status == 'open'
        && request.resource.data.resolvedAt == null
        && request.resource.data.resolvedBy == null
        && request.resource.data.orphaned == false
        && validAnchor(request.resource.data.anchor);
      // Any reviewer may change status (the implementer is often not the author),
      // but no reviewer may rewrite the original anchor or authoring record,
      // and an ordinary update can never leave or restore deleting state.
      allow update: if reviewer()
        && resource.data.status in ['open', 'resolved']
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.anchor == resource.data.anchor
        && request.resource.data.status in ['open', 'resolved']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'resolvedAt', 'resolvedBy', 'orphaned', 'updatedAt']);

      // Owner deletion is persisted and one-way. Messages are removed first;
      // Firestore does not cascade, so the parent is always deleted last.
      allow update: if owner()
        && resource.data.status in ['open', 'resolved']
        && request.resource.data.status == 'deleting'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if owner() && resource.data.status == 'deleting';

      match /messages/{messageId} {
        allow read: if reviewer();
        allow create: if reviewer()
          && parentAfter(prototypeId, threadId).data.status in ['open', 'resolved']
          && request.resource.data.author.uid == request.auth.uid
          && request.resource.data.author.email == request.auth.token.email
          && request.resource.data.agent == false;
        // A message body belongs to its author. The agent's Admin SDK bypasses
        // these browser rules by construction and is bounded in tools/comments.js.
        allow update: if reviewer()
          && parentAfter(prototypeId, threadId).data.status in ['open', 'resolved']
          && resource.data.author.uid == request.auth.uid
          && request.resource.data.author == resource.data.author
          && request.resource.data.agent == resource.data.agent;
        allow delete: if owner()
          && get(/databases/$(database)/documents/prototypes/$(prototypeId)/threads/$(threadId)).data.status
            == 'deleting';
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
